<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base application theme. Kept minimal so Jetpack Compose controls all visuals.
      System bars are handled by enableEdgeToEdge() in MainActivity; the deprecated
      windowTranslucentStatus/Navigation flags are intentionally not used.
      values-night/styles.xml provides the dark variant so the launch window
      matches the system theme instead of flashing white.
    -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
